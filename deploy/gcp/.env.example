# Operonix — Google Cloud deployment configuration.
#
# Copy to deploy/gcp/.env and fill in. The file is git-ignored and .dockerignore-d, so it must never
# reach version control or the container image. Real environment variables override these values.
#
#   cp deploy/gcp/.env.example deploy/gcp/.env
#
# NOTE: no secret VALUE belongs in this file. The database password and the JWT signing key live in
# Secret Manager and are injected into Cloud Run at runtime
# (see docs/GOOGLE_CLOUD_DEPLOYMENT.md → "Secrets").

# ------------------------------------------------------------------ required

# Google Cloud project that owns every resource below.
PROJECT_ID=your-gcp-project-id

# ------------------------------------------------------------------ environment and naming

# staging | production — selects the service/job names and the Secret Manager env.
ENV=staging

# asia-south1 is the initial default, not a hardcoded assumption. Pick the region closest to your
# users: asia-south1 (Mumbai), asia-south2 (Delhi), europe-west1, us-central1, ...
REGION=asia-south1

# Resource names. Keep them identical across environments except the ENV suffix appended to
# SERVICE and JOB.
AR_REPO=operonix
IMAGE=operonix
SERVICE=operonix-api
JOB=operonix-migrate

# ------------------------------------------------------------------ Cloud SQL

DB_INSTANCE=operonix-postgres
DB_NAME=operonix
DB_USER=operonix
# Shared-core tiers for staging (db-g1-small); use db-custom-* for production traffic.
# See docs/OPERATIONS_RUNBOOK.md ("Connection budget") before raising MAX_INSTANCES.
DB_TIER=db-g1-small

# Hikari pool size PER Cloud Run instance. Keep (DB_POOL x MAX_INSTANCES) + headroom below the
# Cloud SQL max_connections limit.
DB_POOL=5

# ------------------------------------------------------------------ Secret Manager

DB_PASSWORD_SECRET=operonix-db-password
JWT_SECRET_NAME=operonix-jwt-secret

# Runtime identity for Cloud Run (least privilege: Cloud SQL client, Secret Manager accessor,
# logging + monitoring writers only). Leave empty to use the default below.
# RUN_SA=operonix-run-staging@your-gcp-project-id.iam.gserviceaccount.com

# ------------------------------------------------------------------ Cloud Run sizing

CPU=1
MEMORY=1Gi
# 0 keeps the service scale-to-zero (cheapest, cold start on first request; worst case ~5-10s
# because the JVM plus Flyway check must start). Use 1 for production latencies without traffic dips.
MIN_INSTANCES=0
MAX_INSTANCES=3
CONCURRENCY=80

# ------------------------------------------------------------------ optional

# Override the image tag (defaults to the current commit short SHA).
# TAG=
# Skip the Cloud Run lookup during `smoke` by pointing at an explicit URL.
# OPERONIX_URL=https://operonix-api-staging-abc123-asia-south1.run.app
